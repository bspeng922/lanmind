{
  "name": "lanmind",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "desktop:unix": "bash scripts/dev-desktop.sh",
    "build": "npm run check:i18n && node scripts/sync-receiver-assets.mjs && vite build && node scripts/build-receiver.mjs && node scripts/install-receiver.mjs",
    "build:receiver": "npm run check:i18n && node scripts/build-receiver.mjs",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "desktop:build:unix": "bash scripts/build-desktop.sh",
    "package:deployment": "powershell -ExecutionPolicy Bypass -File scripts/package-deployment.ps1",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node scripts/run-unit-tests.mjs",
    "test:optical": "tsx --test src/optical/core/core.test.ts src/optical/core/capacity.test.ts",
    "test:optical:capacity": "tsx --test src/optical/core/capacity.test.ts",
    "test:optical:browser": "playwright test --config=playwright.optical.config.ts",
    "lint": "tsc --noEmit",
    "test:theme": "playwright test",
    "screenshots:generate": "playwright test --config=playwright.previews.config.ts",
    "test:wiki-polish": "tsx --test src/components/wiki/wikiPolish.test.ts && playwright test tests/theme/wiki-polish.spec.ts",
    "test:ai-questions": "tsx --test src/components/ai/askUser.test.ts && playwright test tests/theme/ai-questions.spec.ts",
    "test:task-content": "tsx --test src/utils/taskChecklist.test.ts src/utils/taskLinks.test.ts src/utils/taskDuplicate.test.ts src/utils/taskListPresentation.test.ts",
    "i18n:generate": "node scripts/i18n-resources.mjs",
    "predev": "npm run i18n:generate",
    "check:i18n": "node scripts/i18n-resources.mjs && node scripts/check-i18n.mjs",
    "test:i18n": "tsx --test src/i18n/i18n.test.ts src/utils/quickParseHeuristic.test.ts",
    "plugin:package": "node scripts/package-web-plugin.mjs",
    "test:plugins": "tsx --test src/plugins/catalog.test.ts && node --test scripts/package-web-plugin.test.mjs scripts/web-plugin-runtime.test.mjs",
    "lint:strict": "tsc -p tsconfig.strict.json",
    "lint:prototype": "tsc -p tsconfig.prototype.json",
    "lint:all": "npm run lint && npm run lint:strict && npm run lint:prototype",
    "check:bundles": "node scripts/measure-bundles.mjs --check",
    "measure:bundles": "node scripts/measure-bundles.mjs",
    "audit:rust": "node scripts/check-rust-advisories.mjs"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@google/genai": "^2.4.0",
    "@noble/hashes": "2.4.0",
    "@plantuml/core": "1.2026.9",
    "@raptorqr/fast-qr-wasm": "0.1.1",
    "@raptorqr/raptorq-wasm": "0.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@viz-js/viz": "3.31.0",
    "chart.js": "4.5.1",
    "diff-match-patch": "1.0.5",
    "docx": "^9.14.0",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "echarts": "6.1.0",
    "express": "^4.21.2",
    "flowchart.js": "1.18.1",
    "html2canvas-pro": "^2.5.0",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "katex": "0.19.1",
    "lucide-react": "^0.546.0",
    "lunar-typescript": "^1.8.6",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mediabunny": "1.59.1",
    "mermaid": "12.2.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.16",
    "vditor": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zxing-wasm": "3.1.0"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "overrides": {
    "katex": "$katex",
    "pptxgenjs": {
      "image-size": "2.1.0"
    }
  }
}
