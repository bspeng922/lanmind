{
  "extends": "./tsconfig.json",
  "compilerOptions": { "strict": true, "allowJs": false, "types": ["vite/client", "node"] },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "plugins/**/*.test.ts", "src-tauri", "node_modules", "dist"]
}
